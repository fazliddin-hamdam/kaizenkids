# --- Telegram ---
# @BotFather'dan aldığınız bot token'ı
BOT_TOKEN=123456789:AA...

# Mini App'in HTTPS adresi (Telegram yalnızca HTTPS kabul eder).
# Geliştirmede: `cloudflared tunnel --url http://localhost:5173` veya ngrok adresi.
# Üretimde: sunucunuzun adresi (Express, apps/web/dist klasörünü sunar).
WEBAPP_URL=https://ornek.trycloudflare.com

# --- Sunucu ---
PORT=3000
DB_PATH=data/kaizenkids.db
APP_TIMEZONE=Europe/Istanbul

# Sürpriz Kutu için gereken puan (tam bir okul günü = 100 puan)
BOX_THRESHOLD=100

# --- Yalnızca geliştirme ---
# true ise Telegram dışından (normal tarayıcıdan) açıldığında DEV_USER_ID kullanılır.
# Onay mesajları bu ID'ye gider; kendi Telegram ID'nizi yazın (@userinfobot ile öğrenebilirsiniz).
DEV_AUTH_BYPASS=false
DEV_USER_ID=0
